# Copy to supabase/functions/.env (git-ignored). Generate the secret with:
#   openssl rand -base64 32   then prefix it with "v1,whsec_"
SEND_SMS_HOOK_SECRET=v1,whsec_REPLACE_ME
# Local e-mails: delivered to Mailpit (http://127.0.0.1:54324)
SMTP_HOST=inbucket
PRO_APP_URL=http://localhost:5174
CLIENT_APP_URL=http://localhost:5173
MAIL_FROM=no-reply@zelate.test
# Production: BREVO_API_KEY, MAIL_FROM, PRO_APP_URL, CLIENT_APP_URL
SMTP_PORT=1025
